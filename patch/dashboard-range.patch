+import { createRoot } from 'solid-js';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+import { queryLog, querylogClear } from 'panel/api/generated';
+import { addErrorToast } from 'panel/stores/toasts';
+import {
+    getAdditionalLogs,
+    queryLogsState,
+    setFilteredLogs,
+    setLiveLogsEnabled,
+    setLogsFilter,
+} from 'panel/stores/queryLogs';
+import { LIVE_LOG_STORAGE_KEY } from 'panel/helpers/liveQueryLog';
+import { useLiveQueryLog } from 'panel/components/QueryLog/useLiveQueryLog';
+
+vi.mock('panel/api/generated', () => ({
+    queryLog: vi.fn(),
+    querylogClear: vi.fn(),
+    getQueryLogConfig: vi.fn(),
+}));
+
+vi.mock('panel/stores/toasts', () => ({
+    addErrorToast: vi.fn(),
+    addSuccessToast: vi.fn(),
+}));
+
+// Most fixtures are nanoseconds apart; lifecycle cases disable the late-arrival window.
+vi.mock('panel/helpers/liveQueryLogRecovery', async (importOriginal) => {
+    const actual = await importOriginal<typeof import('panel/helpers/liveQueryLogRecovery')>();
+    return {
+        ...actual,
+        recoverLiveLogs: (fetchPage: any, checkpoint: any, options: any = {}) =>
+            actual.recoverLiveLogs(fetchPage, checkpoint, { lateWindowMs: 0, ...options }),
+        liveLogWindowStart: (checkpoint: any) => actual.liveLogWindowStart(checkpoint, 0),
+    };
+});
+
+const FILTER = { search: '', status: 'all', reason: 'all' };
+const time = (id: number) => `2026-10-01T12:00:00.${String(id).padStart(9, '0')}Z`;
+const rawRow = (id: number) => ({
+    time: time(id),
+    client: '192.0.2.10',
+    question: { name: 'example.test', type: 'A', class: 'IN' },
+    reason: 'FilteredBlackList',
+    status: 'NXDOMAIN',
+    answer: [] as unknown[],
+    rules: [] as unknown[],
+    elapsedMs: '0.01',
+});
+const response = (...ids: number[]) => ({ data: ids.map(rawRow), oldest: '' });
+const times = () => queryLogsState.logs.map((entry) => entry.time);
+const api = vi.mocked(queryLog);
+
+describe('Live Query Log polling lifecycle', () => {
+    let dispose: (() => void) | undefined;
+    let controls: ReturnType<typeof useLiveQueryLog>;
+    let element: HTMLDivElement;
+    let barBottom: number;
+    const onlineDescriptor = Object.getOwnPropertyDescriptor(navigator, 'onLine');
+    const visibleDescriptor = Object.getOwnPropertyDescriptor(document, 'visibilityState');
+
+    const mount = (live = true) => {
+        localStorage.setItem(LIVE_LOG_STORAGE_KEY, JSON.stringify(live));
+        createRoot((disposeRoot) => {
+            dispose = disposeRoot;
+            controls = useLiveQueryLog(() => element);
+        });
+    };
+    const tick = async (ms = 1000) => {
+        await vi.advanceTimersByTimeAsync(ms);
+    };
+    const visibility = (state: 'visible' | 'hidden') => {
+        Object.defineProperty(document, 'visibilityState', { configurable: true, value: state });
+        document.dispatchEvent(new Event('visibilitychange'));
+    };
+    const scrollAway = (away: boolean) => {
+        barBottom = away ? -500 : 100;
+        Object.defineProperty(window, 'scrollY', { configurable: true, value: away ? 900 : 0 });
+        window.dispatchEvent(new Event('scroll'));
+    };
+    // The regular page load that precedes Live View.
+    const load = async (...ids: number[]) => {
+        api.mockResolvedValueOnce(response(...ids) as any);
+        await setFilteredLogs(queryLogsState.filter);
+    };
+
+    beforeEach(async () => {
+        vi.useFakeTimers();
+        localStorage.clear();
+        api.mockReset().mockResolvedValue(response(1) as any);
+        vi.mocked(addErrorToast).mockClear();
+        vi.mocked(querylogClear).mockClear();
+        Object.defineProperty(navigator, 'onLine', { configurable: true, value: true });
+        Object.defineProperty(document, 'visibilityState', {
+            configurable: true,
+            value: 'visible',
+        });
+        element = document.createElement('div');
+        barBottom = 100;
+        vi.spyOn(element, 'getBoundingClientRect').mockImplementation(
+            () => ({ bottom: barBottom }) as DOMRect,
+        );
+        element.scrollIntoView = vi.fn();
+        window.scrollTo = vi.fn() as any;
+        Object.defineProperty(window, 'scrollY', { configurable: true, value: 0 });
+        setLiveLogsEnabled(false);
+        setLogsFilter({ ...FILTER, search: 'reset' });
+        setLogsFilter(FILTER);
+        await load(1);
+        api.mockClear();
+    });
+
+    afterEach(() => {
+        dispose?.();
+        dispose = undefined;
+        vi.useRealTimers();
+        if (onlineDescriptor) Object.defineProperty(navigator, 'onLine', onlineDescriptor);
+        if (visibleDescriptor)
+            Object.defineProperty(document, 'visibilityState', visibleDescriptor);
+    });
+
+    it('restores Live, polls at one second, persists pause, and stops requests', async () => {
+        mount(true);
+        expect(controls.live()).toBe(true);
+        await tick();
+        expect(api).toHaveBeenCalledTimes(1);
+        expect(api.mock.calls[0][0]).toMatchObject({ limit: 100, older_than: undefined });
+        await tick();
+        expect(api).toHaveBeenCalledTimes(2);
+        expect(controls.status()).toBe('synced');
+
+        controls.toggleLive();
+        expect(controls.status()).toBe('paused');
+        expect(localStorage.getItem(LIVE_LOG_STORAGE_KEY)).toBe('false');
+        await tick(5000);
+        expect(api).toHaveBeenCalledTimes(2);
+    });
+
+    it('defaults to Paused and starts one loop when enabled', async () => {
+        mount(false);
+        await tick(3000);
+        expect(api).not.toHaveBeenCalled();
+        controls.toggleLive();
+        controls.toggleLive();
+        controls.toggleLive();
+        await tick();
+        expect(api).toHaveBeenCalledTimes(1);
+    });
+
+    it('does not overlap slow requests and ignores results after a pause', async () => {
+        let resolveSlow: (value: unknown) => void = () => {};
+        api.mockReturnValueOnce(new Promise((resolve) => (resolveSlow = resolve)) as any);
+        mount(true);
+        await tick();
+        controls.toggleLive();
+        controls.toggleLive();
+        await tick(3000);
+        expect(api).toHaveBeenCalledTimes(1);
+        resolveSlow(response(9, 1));
+        await tick(0);
+        expect(times()).not.toContain(time(9));
+        await tick(1000);
+        expect(api).toHaveBeenCalledTimes(2);
+    });
+
+    it('cleans up the timer, listeners and in-flight request on unmount', async () => {
+        let signal: AbortSignal | undefined;
+        api.mockImplementationOnce(((_params: unknown, options: RequestInit) => {
+            signal = options.signal ?? undefined;
+            return new Promise(() => {});
+        }) as any);
+        mount(true);
+        await tick();
+        dispose?.();
+        dispose = undefined;
+        expect(signal?.aborted).toBe(true);
+        visibility('hidden');
+        visibility('visible');
+        await tick(5000);
+        expect(api).toHaveBeenCalledTimes(1);
+    });
+
+    it('suspends while hidden, aborts a pending poll, and resumes one loop when visible', async () => {
+        let signal: AbortSignal | undefined;
+        api.mockImplementationOnce(((_params: unknown, options: RequestInit) => {
+            signal = options.signal ?? undefined;
+            // Like fetch, the request rejects when it is aborted.
+            return new Promise((_resolve, reject) =>
+                signal?.addEventListener('abort', () => reject(new Error('aborted'))),
+            );
+        }) as any);
+        mount(true);
+        await tick();
+        visibility('hidden');
+        expect(signal?.aborted).toBe(true);
+        expect(controls.status()).toBe('suspended');
+        await tick(5000);
+        expect(api).toHaveBeenCalledTimes(1);
+        visibility('visible');
+        await tick(0);
+        expect(api).toHaveBeenCalledTimes(2);
+        await tick(1000);
+        expect(api).toHaveBeenCalledTimes(3);
+    });
+
+    it('passes the server filters and ignores responses for an obsolete filter', async () => {
+        const blocked = { search: 'example', status: 'blocked', reason: 'all' };
+        setLogsFilter(blocked);
+        await load(1);
+        api.mockClear();
+        let resolveOld: (value: unknown) => void = () => {};
+        api.mockReturnValueOnce(new Promise((resolve) => (resolveOld = resolve)) as any);
+        mount(true);
+        await tick();
+        expect(api.mock.calls[0][0]).toMatchObject({
+            search: 'example',
+            reason: expect.arrayContaining(['FilteredBlackList']),
+        });
+        setLogsFilter(FILTER);
+        await load(2);
+        resolveOld(response(50, 2));
+        await tick(0);
+        expect(times()).toEqual([time(2)]);
+    });
+
+    it('waits for a regular filter refresh before polling', async () => {
+        let resolveRefresh: (value: unknown) => void = () => {};
+        api.mockReturnValueOnce(new Promise((resolve) => (resolveRefresh = resolve)) as any);
+        const refresh = setFilteredLogs(FILTER);
+        mount(true);
+        await tick(3000);
+        expect(api).toHaveBeenCalledTimes(1);
+        resolveRefresh(response(1));
+        await refresh;
+        await tick();
+        expect(api).toHaveBeenCalledTimes(2);
+    });
+
+    it('queues while scrolled away without replacing visible rows, then reveals on request', async () => {
+        mount(true);
+        await tick();
+        scrollAway(true);
+        api.mockResolvedValue(response(3, 2, 1) as any);
+        await tick();
+        expect(times()).toEqual([time(1)]);
+        expect(controls.pendingCount()).toBe(2);
+        expect(element.scrollIntoView).not.toHaveBeenCalled();
+        controls.showNewest();
+        expect(times()).toEqual([time(3), time(2), time(1)]);
+        expect(controls.pendingCount()).toBe(0);
+        expect(element.scrollIntoView).toHaveBeenCalled();
+    });
+
+    it('reveals queued rows when the reader scrolls back to the top', async () => {
+        mount(true);
+        await tick();
+        scrollAway(true);
+        api.mockResolvedValue(response(2, 1) as any);
+        await tick();
+        expect(controls.pendingCount()).toBe(1);
+        scrollAway(false);
+        expect(times()).toEqual([time(2), time(1)]);
+    });
+
+    it('retains rows on failure, backs off, shows one toast per outage, and recovers', async () => {
+        mount(true);
+        await tick();
+        api.mockRejectedValue(new Error('offline'));
+        await tick();
+        expect(controls.status()).toBe('reconnecting');
+        expect(times()).toEqual([time(1)]);
+        await tick(1000);
+        expect(api).toHaveBeenCalledTimes(2);
+        await tick(4000);
+        expect(api).toHaveBeenCalledTimes(3);
+        expect(addErrorToast).toHaveBeenCalledTimes(1);
+        api.mockResolvedValue(response(2, 1) as any);
+        await tick(5000);
+        expect(controls.status()).toBe('synced');
+        expect(times()).toEqual([time(2), time(1)]);
+    });
+
+    it('Clear view never calls the server clear endpoint and only later arrivals appear', async () => {
+        mount(true);
+        await tick();
+        controls.clearView();
+        expect(times()).toEqual([]);
+        expect(querylogClear).not.toHaveBeenCalled();
+        api.mockResolvedValue(response(1) as any);
+        await tick();
+        expect(times()).toEqual([]);
+        api.mockResolvedValue(response(2, 1) as any);
+        await tick();
+        expect(times()).toEqual([time(2)]);
+    });
+
+    it('uses an empty baseline if Clear view precedes the first Live response', async () => {
+        mount(true);
+        controls.clearView();
+        api.mockResolvedValue(response(4, 3) as any);
+        await tick();
+        expect(times()).toEqual([]);
+        api.mockResolvedValue(response(5, 4, 3) as any);
+        await tick();
+        expect(times()).toEqual([time(5)]);
+    });
+
+    it('does not advance the checkpoint on malformed data and toasts once', async () => {
+        mount(true);
+        await tick();
+        api.mockResolvedValue({ data: [{ time: 'not a time' }], oldest: '' } as any);
+        await tick();
+        expect(controls.status()).toBe('reconnecting');
+        expect(addErrorToast).toHaveBeenCalledTimes(1);
+        expect(times()).toEqual([time(1)]);
+    });
+
+    it('aborts a stalled request at the elapsed deadline and retries without overlap', async () => {
+        mount(true);
+        await tick();
+        let signal: AbortSignal | undefined;
+        api.mockImplementationOnce(((_params: unknown, options: RequestInit) => {
+            signal = options.signal ?? undefined;
+            return new Promise((_resolve, reject) =>
+                signal?.addEventListener('abort', () =>
+                    reject(new Error('control/querylog | aborted')),
+                ),
+            );
+        }) as any);
+        await tick();
+        expect(api).toHaveBeenCalledTimes(2);
+        await tick(4999);
+        expect(signal?.aborted).toBe(false);
+        await tick(1);
+        expect(signal?.aborted).toBe(true);
+        expect(controls.status()).toBe('reconnecting');
+        expect(api).toHaveBeenCalledTimes(2);
+        await tick(5000);
+        expect(api).toHaveBeenCalledTimes(3);
+    });
+
+    it('reports an unusable cursor as a sticky gap distinct from a network error', async () => {
+        mount(true);
+        await tick();
+        api.mockResolvedValue({ data: [rawRow(2)], oldest: 'not-a-cursor' } as any);
+        await tick();
+        expect(controls.hasGap()).toBe(true);
+        expect(controls.status()).toBe('gap');
+        expect(addErrorToast).not.toHaveBeenCalled();
+        api.mockResolvedValue(response(3, 2) as any);
+        await tick();
+        expect(controls.status()).toBe('gap');
+    });
+
+    it('keeps regular pagination out of the live window', async () => {
+        mount(true);
+        await tick();
+        api.mockClear();
+        await getAdditionalLogs();
+        expect(api).not.toHaveBeenCalled();
+    });
+});
