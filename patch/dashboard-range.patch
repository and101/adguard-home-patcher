+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+import { queryLog } from 'panel/api/generated';
+import {
+    clearLiveLogsView,
+    getAdditionalLogs,
+    queryLogsState,
+    receiveLiveLogs,
+    revealPendingLogs,
+    setFilteredLogs,
+    setLiveLogsEnabled,
+    setLogsFilter,
+} from 'panel/stores/queryLogs';
+import type { QueryLogRow } from 'panel/stores/queryLogs';
+
+vi.mock('panel/api/generated', () => ({
+    queryLog: vi.fn(),
+    getQueryLogConfig: vi.fn(),
+}));
+
+vi.mock('panel/stores/toasts', () => ({
+    addErrorToast: vi.fn(),
+    addSuccessToast: vi.fn(),
+}));
+
+const FILTER = { search: '', status: 'all', reason: 'all' };
+const time = (value: number) => `2026-10-01T12:00:00.${String(value).padStart(9, '0')}Z`;
+const apiRow = (value: number) => ({
+    time: time(value),
+    client: '192.0.2.10',
+    question: { name: 'example.test', type: 'A', class: 'IN' },
+    reason: 'NotFilteredNotFound',
+    status: 'NOERROR',
+});
+const apiRows = (newest: number, count: number) =>
+    Array.from({ length: count }, (_, index) => apiRow(newest - index));
+const liveRow = (value: number) =>
+    ({
+        time: time(value),
+        client: '192.0.2.10',
+        domain: 'example.test',
+        type: 'A',
+        reason: 'NotFilteredNotFound',
+        status: 'NOERROR',
+        response: [],
+        originalResponse: [],
+        rules: [],
+    }) as unknown as QueryLogRow;
+const times = () => queryLogsState.logs.map((entry) => entry.time);
+
+// An empty cursor ends the short-poll top-up after one page.
+const load = async (newest: number, count: number, oldest = '') => {
+    (queryLog as any).mockResolvedValueOnce({ data: apiRows(newest, count), oldest });
+    await setFilteredLogs(FILTER);
+};
+
+describe('Live Query Log store integration', () => {
+    beforeEach(async () => {
+        vi.clearAllMocks();
+        (queryLog as any).mockReset();
+        setLiveLogsEnabled(false);
+        setLogsFilter({ ...FILTER, search: 'reset' });
+        setLogsFilter(FILTER);
+        await load(10, 3);
+    });
+
+    it('does not load older pages into the live window', async () => {
+        setLiveLogsEnabled(true);
+        (queryLog as any).mockClear();
+        await getAdditionalLogs();
+        expect(queryLog).not.toHaveBeenCalled();
+        expect(times()).toEqual([time(10), time(9), time(8)]);
+    });
+
+    it('ignores a regular page that finishes after a newer request started', async () => {
+        let resolveSlow: (value: unknown) => void = () => {};
+        (queryLog as any).mockReturnValueOnce(new Promise((resolve) => (resolveSlow = resolve)));
+        const slow = getAdditionalLogs();
+        await load(20, 2);
+        resolveSlow({ data: apiRows(5, 2), oldest: '' });
+        await slow;
+        expect(times()).toEqual([time(20), time(19)]);
+    });
+
+    it('queues arrivals while scrolled away and reveals them on request', () => {
+        setLiveLogsEnabled(true);
+        receiveLiveLogs([liveRow(12), liveRow(11), liveRow(10)], false);
+        expect(times()).toEqual([time(10), time(9), time(8)]);
+        expect(queryLogsState.livePending).toHaveLength(2);
+        revealPendingLogs();
+        expect(times()).toEqual([time(12), time(11), time(10), time(9), time(8)]);
+        expect(queryLogsState.livePending).toHaveLength(0);
+        // Paused pagination continues from the oldest displayed row.
+        expect(queryLogsState.oldest).toBe(time(8));
+    });
+
+    it('keeps cleared rows out after a refresh of the same filter, but not after a filter change', async () => {
+        setLiveLogsEnabled(true);
+        clearLiveLogsView(time(10));
+        expect(times()).toEqual([]);
+        await load(11, 4);
+        expect(times()).toEqual([time(11)]);
+        setLogsFilter({ ...FILTER, search: 'other' });
+        await load(11, 4);
+        expect(times()).toEqual([time(11), time(10), time(9), time(8)]);
+    });
+
+    it('lets a filter request started before Live View rebuild the live window', async () => {
+        let resolveFilter: (value: unknown) => void = () => {};
+        (queryLog as any).mockReturnValueOnce(new Promise((resolve) => (resolveFilter = resolve)));
+        const pending = setFilteredLogs(FILTER);
+        setLiveLogsEnabled(true);
+        resolveFilter({ data: apiRows(30, 2), oldest: '' });
+        expect(await pending).toBe(true);
+        expect(times()).toEqual([time(30), time(29)]);
+        expect(queryLogsState.processingGetLogs).toBe(false);
+    });
+});
