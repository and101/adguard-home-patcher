@@ -0,0 +1,220 @@
+// Live Query Log view model.  Everything here runs in the browser only: the
+// server Query Log, its configuration and its history are never changed.
+
+import { LocalStorageHelper } from 'panel/helpers/localStorageHelper';
+
+export const LIVE_LOG_STORAGE_KEY = 'query_log_live';
+export const LIVE_LOG_INTERVAL_MS = 1000;
+export const LIVE_LOG_RETRY_MS = 5000;
+export const LIVE_LOG_PAGE_SIZE = 100;
+// At most 500 rendered rows plus 500 queued rows. Recent identities are also bounded.
+export const LIVE_LOG_MAX_ROWS = 500;
+// One merged poll can carry a full recovery cycle, including the re-read late-arrival window.
+export const LIVE_LOG_MAX_BATCH = 2000;
+
+export type LiveLogRow = { time: string; liveKey?: string; [field: string]: any };
+export type LiveLogView<T extends LiveLogRow = LiveLogRow> = {
+    logs: T[];
+    livePending: T[];
+    liveSeen: string[];
+    liveNewest: string;
+    liveFloor: string;
+    liveClearedThrough: string;
+};
+
+export const loadLiveLogPreference = () =>
+    LocalStorageHelper.getItem(LIVE_LOG_STORAGE_KEY) === true;
+export const saveLiveLogPreference = (enabled: boolean) =>
+    LocalStorageHelper.setItem(LIVE_LOG_STORAGE_KEY, enabled);
+
+// Preserve the full API timestamp, including sub-millisecond precision. Client metadata
+// and tracker labels are excluded because they can change between reads of one request.
+export const queryIdentity = (row: LiveLogRow) =>
+    JSON.stringify([
+        row.time,
+        row.client,
+        row.client_id,
+        row.client_proto,
+        row.domain,
+        row.type,
+        row.reason,
+        row.status,
+        row.response,
+        row.originalResponse,
+        row.rules,
+        row.elapsedMs,
+        row.upstream,
+        row.cached,
+        row.answer_dnssec,
+        row.ecs,
+    ]);
+
+export const identifyLiveLogs = <T extends LiveLogRow>(
+    rows: T[],
+    limit = LIVE_LOG_MAX_ROWS,
+): T[] => {
+    const occurrences = new Map<string, number>();
+
+    return rows.slice(0, limit).map((row) => {
+        const identity = queryIdentity(row);
+        const occurrence = occurrences.get(identity) || 0;
+        occurrences.set(identity, occurrence + 1);
+        const liveKey = `${identity}:${occurrence}`;
+
+        // A multiset preserves even indistinguishable records occurring in one page.
+        return row.liveKey === liveKey ? row : { ...row, liveKey };
+    });
+};
+
+export const compareTimes = (left: string, right: string) => {
+    const milliseconds = Date.parse(left) - Date.parse(right);
+    const fraction = (time: string) => (time.match(/\.(\d+)/)?.[1] || '').padEnd(9, '0');
+    return milliseconds || fraction(left).localeCompare(fraction(right));
+};
+
+const newestFirst = <T extends LiveLogRow>(rows: T[]) =>
+    rows.sort((left, right) => compareTimes(right.time, left.time));
+
+export const createLiveLogView = <T extends LiveLogRow>(
+    rows: T[],
+    clearedThrough = '',
+): LiveLogView<T> => {
+    const logs = identifyLiveLogs(
+        rows.filter((row) => !clearedThrough || compareTimes(row.time, clearedThrough) > 0),
+    );
+
+    return {
+        logs,
+        livePending: [],
+        liveSeen: logs.map((row) => row.liveKey),
+        liveNewest: logs[0]?.time || '',
+        liveFloor: logs[logs.length - 1]?.time || '',
+        liveClearedThrough: clearedThrough,
+    };
+};
+
+export const EMPTY_LIVE_LOG_VIEW: LiveLogView<never> = createLiveLogView<never>([]);
+
+export const mergeLiveLogView = <T extends LiveLogRow>(
+    state: LiveLogView<T>,
+    incoming: T[],
+    atTop: boolean,
+    fromTime?: string,
+): LiveLogView<T> => {
+    const batch = identifyLiveLogs(incoming, LIVE_LOG_MAX_BATCH);
+    const seen = new Set([
+        ...state.liveSeen,
+        ...state.logs.map((row) => row.liveKey),
+        ...state.livePending.map((row) => row.liveKey),
+    ]);
+    // The regular initial page is smaller than a live page. Do not count older
+    // backfill as new arrivals or reinsert trimmed/cleared history on later polls.
+    // A retry can recover rows older than those displayed after a partial response.
+    // Its independent acquisition checkpoint permits these rows despite UI trimming.
+    const floor =
+        fromTime !== undefined &&
+        (!fromTime || (state.liveFloor && compareTimes(fromTime, state.liveFloor) < 0))
+            ? fromTime
+            : state.liveFloor;
+    const added = batch.filter(
+        (row) =>
+            !seen.has(row.liveKey) &&
+            (!floor || compareTimes(row.time, floor) >= 0) &&
+            (!state.liveClearedThrough || compareTimes(row.time, state.liveClearedThrough) > 0),
+    );
+    const newest = batch[0]?.time;
+    const liveNewest =
+        newest && (!state.liveNewest || compareTimes(newest, state.liveNewest) > 0)
+            ? newest
+            : state.liveNewest;
+    const liveSeen = batch.map((row) => row.liveKey);
+    const sameBatch =
+        liveSeen.length === state.liveSeen.length &&
+        liveSeen.every((key, index) => key === state.liveSeen[index]);
+
+    if (added.length === 0 && sameBatch) {
+        return state;
+    }
+
+    if (!atTop) {
+        return {
+            ...state,
+            liveSeen,
+            liveNewest,
+            livePending: added.length
+                ? newestFirst([...added, ...state.livePending]).slice(0, LIVE_LOG_MAX_ROWS)
+                : state.livePending,
+        };
+    }
+
+    const logs =
+        added.length || state.livePending.length
+            ? newestFirst([...added, ...state.livePending, ...state.logs]).slice(
+                  0,
+                  LIVE_LOG_MAX_ROWS,
+              )
+            : state.logs;
+    return {
+        ...state,
+        liveSeen,
+        liveNewest,
+        logs,
+        livePending: [],
+        liveFloor: logs[logs.length - 1]?.time || state.liveFloor,
+    };
+};
+
+export const revealLiveLogs = <T extends LiveLogRow>(state: LiveLogView<T>): LiveLogView<T> => {
+    if (!state.livePending.length) {
+        return state;
+    }
+    const logs = newestFirst([...state.livePending, ...state.logs]).slice(0, LIVE_LOG_MAX_ROWS);
+    return {
+        ...state,
+        logs,
+        livePending: [],
+        liveFloor: logs[logs.length - 1]?.time || state.liveFloor,
+    };
+};
+
+// clearLiveLogView empties the browser view and records the newest time it
+// has seen, so later polls never bring cleared rows back.
+export const clearLiveLogView = <T extends LiveLogRow>(
+    state: LiveLogView<T>,
+    through = '',
+): LiveLogView<T> => {
+    const boundary =
+        [state.liveClearedThrough, state.liveNewest, through]
+            .filter(Boolean)
+            .sort(compareTimes)
+            .pop() || '';
+    return {
+        ...state,
+        logs: [],
+        livePending: [],
+        liveClearedThrough: boundary,
+        liveFloor: boundary,
+    };
+};
+
+// The strings are kept here instead of in the locale files so that the patch
+// does not touch files that change in every release.  They are English only.
+export const LIVE_LOG_TEXT = {
+    synced: 'Live / Synced',
+    catching_up: 'Catching up',
+    reconnecting: 'Reconnecting',
+    suspended: 'Suspended',
+    paused: 'Paused',
+    gap: 'Gap detected — some queries may not have been recovered.',
+    status_hint:
+        'Each update re-checks the last few seconds for late queries. A gap is shown if continuity cannot be confirmed.',
+    start: 'Start Live View',
+    pause: 'Pause Live View',
+    clear: 'Clear view',
+    clear_hint:
+        'Clear only the displayed browser Live View. AdGuard Home’s server Query Log and history are kept.',
+    new_hint: 'New queries are waiting while you read older rows. Show the newest queries.',
+};
+
+export const liveLogNewText = (count: number) =>
+    `${count} new ${count === 1 ? 'query' : 'queries'} — Show newest`;
