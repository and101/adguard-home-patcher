+import { createEffect, createSignal, on, onCleanup, untrack } from 'solid-js';
+
+import { queryLog } from 'panel/api/generated';
+import { addErrorToast } from 'panel/stores/toasts';
+import {
+    cancelLogsRequest,
+    clearLiveLogsView,
+    getQueryLogParams,
+    queryLogsState,
+    type QueryLogRow,
+    receiveLiveLogs,
+    revealPendingLogs,
+    setLiveLogsEnabled,
+} from 'panel/stores/queryLogs';
+import { normalizeLogs } from 'panel/helpers/helpers';
+import {
+    compareTimes,
+    identifyLiveLogs,
+    LIVE_LOG_INTERVAL_MS,
+    LIVE_LOG_PAGE_SIZE,
+    LIVE_LOG_RETRY_MS,
+    loadLiveLogPreference,
+    saveLiveLogPreference,
+} from 'panel/helpers/liveQueryLog';
+import {
+    checkpointFor,
+    liveLogWindowStart,
+    LIVE_LOG_RECOVERY_MAX_DURATION_MS,
+    recoverLiveLogs,
+    type LiveLogCheckpoint,
+} from 'panel/helpers/liveQueryLogRecovery';
+
+export type LiveLogStatus =
+    | 'synced'
+    | 'catching_up'
+    | 'reconnecting'
+    | 'suspended'
+    | 'paused'
+    | 'gap';
+
+// The list counts as "at the top" while the bar directly above it is (almost) on screen.
+const AT_TOP_SLACK_PX = 48;
+
+const abortError = () => new DOMException('Live log request cancelled', 'AbortError');
+
+const isValidQueryLogResponse = (response: any) =>
+    response &&
+    Array.isArray(response.data) &&
+    response.data.length <= LIVE_LOG_PAGE_SIZE &&
+    response.data.every(
+        (row: any) =>
+            row &&
+            typeof row.time === 'string' &&
+            Number.isFinite(Date.parse(row.time)) &&
+            row.question &&
+            typeof row.question.name === 'string' &&
+            typeof row.question.type === 'string',
+    );
+
+/**
+ * Polls the existing Query Log API about one second after each completed
+ * request while Live View is on.  Every cycle reads back to the previous
+ * checkpoint (see recoverLiveLogs), so short bursts are not lost, and a gap
+ * is reported when continuity cannot be confirmed.
+ *
+ * @param list Returns the element directly above the rows; while it is on screen the newest rows are visible.
+ */
+export const useLiveQueryLog = (list: () => HTMLElement | undefined) => {
+    const [live, setLive] = createSignal(loadLiveLogPreference());
+    const [phase, setPhase] = createSignal<LiveLogStatus>('catching_up');
+    const [hasGap, setHasGap] = createSignal(false);
+    const [clearRevision, setClearRevision] = createSignal(0);
+
+    let checkpoint: LiveLogCheckpoint | null = null;
+    let gap = false;
+    let failed = false;
+    let busy = false;
+    let atTop = true;
+    let abort: AbortController | undefined;
+    let clearGeneration = 0;
+    let baselineOnly = false;
+    let observedHead = '';
+    // Oldest row read by the cycle that produced the checkpoint. Rows older than this were never read,
+    // so they are history, not late arrivals.
+    let readFloor = '';
+
+    const filterKey = () => JSON.stringify(queryLogsState.filter || {});
+    const canPoll = () =>
+        live() &&
+        queryLogsState.enabled &&
+        !queryLogsState.processingGetConfig &&
+        !queryLogsState.processingGetLogs;
+
+    const resetCheckpoint = () => {
+        checkpoint = null;
+        readFloor = '';
+        observedHead = '';
+        gap = false;
+        baselineOnly = false;
+        setHasGap(false);
+        setPhase('catching_up');
+    };
+
+    createEffect(() => setLiveLogsEnabled(live()));
+
+    // A new filter needs a new baseline: the old checkpoint describes other rows.
+    createEffect(on(filterKey, resetCheckpoint, { defer: true }));
+
+    const updateAtTop = () => {
+        const element = list();
+        atTop =
+            window.scrollY <= 8 ||
+            !element ||
+            element.getBoundingClientRect().bottom >= -AT_TOP_SLACK_PX;
+        if (atTop) {
+            revealPendingLogs();
+        }
+    };
+
+    createEffect(() => {
+        if (!live() || !queryLogsState.enabled) {
+            return;
+        }
+        updateAtTop();
+        window.addEventListener('scroll', updateAtTop, { passive: true });
+        onCleanup(() => window.removeEventListener('scroll', updateAtTop));
+    });
+
+    createEffect(() => {
+        clearRevision();
+        const key = filterKey();
+        if (!canPoll()) {
+            return;
+        }
+
+        let stopped = false;
+        let timer: ReturnType<typeof setTimeout> | undefined;
+        let controller: AbortController | undefined;
+        let cancelForAvailability: (() => void) | undefined;
+        const generation = clearGeneration;
+        const filter = untrack(() => queryLogsState.filter);
+        const current = () =>
+            !stopped &&
+            untrack(canPoll) &&
+            untrack(filterKey) === key &&
+            generation === clearGeneration;
+        const visible = () => document.visibilityState !== 'hidden';
+        const available = () => visible() && navigator.onLine !== false;
+
+        const poll = async () => {
+            if (!current() || !available()) {
+                return;
+            }
+            if (busy) {
+                timer = setTimeout(poll, LIVE_LOG_INTERVAL_MS);
+                return;
+            }
+            busy = true;
+            const request = new AbortController();
+            controller = request;
+            abort = request;
+            let timedOut = false;
+            let interrupted = false;
+            let newestPage: QueryLogRow[] | undefined;
+            const processed = new Map<string, QueryLogRow>();
+            // Late arrivals inside the re-read window must not be dropped by the view's floor, but only
+            // rows within the previous cycle's read range can be late; older ones are unread history.
+            const windowStart = liveLogWindowStart(checkpoint);
+            const fromTime =
+                windowStart && readFloor && compareTimes(readFloor, windowStart) > 0
+                    ? readFloor
+                    : windowStart;
+            // The elapsed budget includes transport time, even for a stalled first page.
+            const deadline = setTimeout(() => {
+                timedOut = true;
+                request.abort();
+            }, LIVE_LOG_RECOVERY_MAX_DURATION_MS);
+            cancelForAvailability = () => {
+                interrupted = true;
+                clearTimeout(deadline);
+                request.abort();
+            };
+            const settle = (logs: QueryLogRow[]) => {
+                if (baselineOnly) {
+                    // The first read after Clear view only sets the baseline.
+                    clearLiveLogsView(observedHead);
+                    baselineOnly = false;
+                } else {
+                    receiveLiveLogs(logs, atTop, fromTime);
+                }
+            };
+            try {
+                const result = await recoverLiveLogs(
+                    async (olderThan?: string) => {
+                        let response: any;
+                        try {
+                            response = await queryLog(
+                                getQueryLogParams(filter, olderThan, LIVE_LOG_PAGE_SIZE),
+                                { signal: request.signal },
+                            );
+                        } catch (error) {
+                            // The API client reports aborts as plain errors.
+                            throw request.signal.aborted ? abortError() : error;
+                        }
+                        if (!current() || request.signal.aborted || !available()) {
+                            throw abortError();
+                        }
+                        // Validate before normalizing: malformed responses must not advance a checkpoint.
+                        if (!isValidQueryLogResponse(response)) {
+                            throw new Error('Invalid Query Log response');
+                        }
+                        const logs: QueryLogRow[] = normalizeLogs(response.data).sort(
+                            (left, right) => compareTimes(right.time, left.time),
+                        );
+                        if (!olderThan) {
+                            newestPage = logs;
+                        }
+                        if (
+                            logs[0] &&
+                            (!observedHead || compareTimes(logs[0].time, observedHead) > 0)
+                        ) {
+                            observedHead = logs[0].time;
+                        }
+                        identifyLiveLogs(logs).forEach((row) => processed.set(row.liveKey!, row));
+                        return { logs, oldest: response.oldest };
+                    },
+                    checkpoint,
+                    {
+                        signal: request.signal,
+                        onCatchUp: () => {
+                            if (current()) setPhase('catching_up');
+                        },
+                    },
+                );
+                if (current() && !request.signal.aborted && available()) {
+                    // The rows are the normalized rows returned by the fetcher above.
+                    settle(result.logs as QueryLogRow[]);
+                    if (!result.error) {
+                        readFloor =
+                            result.logs[result.logs.length - 1]?.time ||
+                            result.checkpoint?.time ||
+                            '';
+                    }
+                    checkpoint = result.checkpoint;
+                    gap = gap || result.gap;
+                    setHasGap(gap);
+                    if (result.error) throw result.error;
+                    failed = false;
+                    setPhase('synced');
+                }
+            } catch (error) {
+                if (
+                    current() &&
+                    available() &&
+                    !interrupted &&
+                    (timedOut || !request.signal.aborted)
+                ) {
+                    if (timedOut && newestPage) {
+                        // Accept a new boundary only with a persistent gap warning, so a slow
+                        // backfill is not restarted on every retry. Keep successfully read rows.
+                        const logs = [...processed.values()].sort((left, right) =>
+                            compareTimes(right.time, left.time),
+                        );
+                        const head = checkpointFor(logs);
+                        checkpoint = head.time ? head : { ...checkpoint, limited: true };
+                        readFloor = logs[logs.length - 1]?.time || checkpoint.time;
+                        gap = true;
+                        setHasGap(true);
+                        settle(logs);
+                        failed = false;
+                        setPhase('synced');
+                        return;
+                    }
+                    // One toast per outage, including across pause/visibility lifecycle changes.
+                    if (!failed) addErrorToast({ error });
+                    failed = true;
+                    setPhase('reconnecting');
+                }
+            } finally {
+                clearTimeout(deadline);
+                cancelForAvailability = undefined;
+                busy = false;
+                clearTimeout(timer);
+                if (current() && available()) {
+                    timer = setTimeout(poll, failed ? LIVE_LOG_RETRY_MS : LIVE_LOG_INTERVAL_MS);
+                }
+            }
+        };
+
+        const onAvailability = () => {
+            clearTimeout(timer);
+            if (current() && available()) {
+                setPhase('catching_up');
+                timer = setTimeout(poll, 0);
+            } else {
+                cancelForAvailability?.();
+                if (current()) setPhase(visible() ? 'reconnecting' : 'suspended');
+            }
+        };
+        document.addEventListener('visibilitychange', onAvailability);
+        window.addEventListener('online', onAvailability);
+        window.addEventListener('offline', onAvailability);
+        if (available()) {
+            setPhase('catching_up');
+            timer = setTimeout(poll, LIVE_LOG_INTERVAL_MS);
+        } else {
+            setPhase(visible() ? 'reconnecting' : 'suspended');
+        }
+
+        onCleanup(() => {
+            stopped = true;
+            clearTimeout(timer);
+            controller?.abort();
+            document.removeEventListener('visibilitychange', onAvailability);
+            window.removeEventListener('online', onAvailability);
+            window.removeEventListener('offline', onAvailability);
+        });
+    });
+
+    const toggleLive = () => {
+        const next = !untrack(live);
+        saveLiveLogPreference(next);
+        setLive(next);
+    };
+
+    const clearView = () => {
+        // Invalidate synchronously so a queued old response cannot refill the cleared table.
+        clearGeneration += 1;
+        abort?.abort();
+        cancelLogsRequest();
+        baselineOnly = checkpoint === null;
+        clearLiveLogsView(observedHead);
+        setClearRevision((revision) => revision + 1);
+    };
+
+    const showNewest = () => {
+        revealPendingLogs();
+        list()?.scrollIntoView({ block: 'start', behavior: 'auto' });
+        window.scrollTo({ top: 0, behavior: 'auto' });
+        atTop = true;
+    };
+
+    const status = (): LiveLogStatus => {
+        if (!live()) {
+            return 'paused';
+        }
+        return hasGap() && phase() === 'synced' ? 'gap' : phase();
+    };
+
+    return {
+        live,
+        toggleLive,
+        clearView,
+        showNewest,
+        status,
+        hasGap,
+        pendingCount: () => queryLogsState.livePending.length,
+    };
+};
