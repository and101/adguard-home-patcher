+.bar {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    gap: 8px 16px;
+    padding: 0 16px;
+
+    @media (min-width: 1024px) {
+        padding: 0;
+    }
+}
+
+/* Raised specificity: the shared button is full width by default. */
+.bar .toggle {
+    flex: 1 1 100%;
+
+    @media (min-width: 768px) {
+        flex: 0 0 auto;
+        width: auto;
+    }
+}
+
+.status {
+    flex: 1 1 auto;
+    display: inline-flex;
+    align-items: center;
+    gap: 8px;
+    min-height: 40px;
+    font-size: 14px;
+    line-height: 20px;
+    color: var(--default-description-text);
+}
+
+.dot {
+    flex-shrink: 0;
+    width: 8px;
+    height: 8px;
+    border-radius: 50%;
+    background: var(--default-gray-icons);
+}
+
+.synced .dot {
+    background: var(--default-main-button);
+    box-shadow: 0 0 0 3px color-mix(in srgb, var(--default-main-button) 25%, transparent);
+}
+
+.synced,
+.gap {
+    color: var(--default-main-text);
+}
+
+.catching_up .dot,
+.gap .dot {
+    background: var(--orange-50);
+}
+
+.reconnecting .dot {
+    background: var(--default-error-icon);
+}
+
+.bar .clear {
+    flex: 0 0 auto;
+    width: auto;
+    min-width: 0;
+    margin-left: auto;
+}
+
+.gapNotice {
+    flex-basis: 100%;
+    margin: 0;
+    font-size: 14px;
+    line-height: 20px;
+    color: var(--default-attention-link);
+}
+
+.srOnly {
+    position: absolute;
+    width: 1px;
+    height: 1px;
+    overflow: hidden;
+    clip: rect(0 0 0 0);
+    white-space: nowrap;
+}
+
+.pending {
+    position: sticky;
+    top: 8px;
+    z-index: 2;
+    display: flex;
+    justify-content: center;
+    margin: 0 16px;
+    pointer-events: none;
+
+    @media (min-width: 1024px) {
+        margin: 0;
+    }
+}
+
+.pending .pendingButton {
+    width: auto;
+    min-width: 0;
+    pointer-events: auto;
+    box-shadow: var(--default-cards-box-shadow);
+}
