+import { describe, expect, it } from 'vitest';
+
+import {
+    padHistory,
+    sumBlocked,
+} from 'panel/components/Dashboard/blocks/QueriesChart/QueriesChart';
+
+describe('combined queries chart', () => {
+    it('adds filtering, safe browsing and parental blocks per bucket', () => {
+        expect(sumBlocked([1, 2, 3], [0, 1], [1, 0, 1])).toEqual([2, 3, 4]);
+        expect(sumBlocked([], [], [])).toEqual([]);
+    });
+
+    it('keeps multi-bucket series and labels every point', () => {
+        const result = padHistory([5, 7, 9], [1, 2, 3], 'hours');
+        expect(result.queries).toEqual([5, 7, 9]);
+        expect(result.blocked).toEqual([1, 2, 3]);
+        expect(result.labels).toHaveLength(3);
+        expect(new Set(result.labels).size).toBe(3);
+    });
