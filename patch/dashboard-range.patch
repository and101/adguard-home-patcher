index 0000000000000000000000000000000000000000..9037630d4f9115cdf5449aa09b9b052ec67696ab
--- /dev/null
+++ b/client_v2/src/__tests__/liveQueryLogRecovery.test.ts
@@ -0,0 +1,640 @@
+import { describe, expect, it, vi } from 'vitest';
+
+import { compareTimes, identifyLiveLogs, LiveLogRow } from 'panel/helpers/liveQueryLog';
+import {
+    LIVE_LOG_RECOVERY_MAX_DURATION_MS,
+    LIVE_LOG_RECOVERY_MAX_PAGES,
+    LIVE_LOG_RECOVERY_MAX_ROWS,
+    LIVE_LOG_LATE_WINDOW_MS,
+    LIVE_LOG_LATE_WINDOW_ROWS,
+    LiveLogCheckpoint,
+    LiveLogPage,
+    LiveLogRecoveryOptions,
+    liveLogWindowStart,
+    recoverLiveLogs,
+    shiftLiveLogTime,
+} from 'panel/helpers/liveQueryLogRecovery';
+
+const time = (value: number) => `2026-10-01T12:00:00.${String(value).padStart(9, '0')}Z`;
+const row = (value: number, extra = {}): LiveLogRow => ({
+    time: time(value),
+    domain: 'example.test',
+    client: '192.0.2.1',
+    type: 'A',
+    ...extra,
+});
+const rows = (count: number, offset = 0) =>
+    Array.from({ length: count }, (_, index) => row(count + offset - index));
+const checkpointFor = (entries: LiveLogRow[]): LiveLogCheckpoint => {
+    const identified = identifyLiveLogs(
+        [...entries].sort((left, right) => compareTimes(right.time, left.time)),
+    );
+    return {
+        time: identified[0]?.time || '',
+        keys: identified
+            .filter((entry) => entry.time === identified[0].time)
+            .map((entry) => entry.liveKey!),
+    };
+};
+// Rows here are nanoseconds apart, so these cases exercise overlap without the late-arrival window.
+const recover = (
+    fetchPage: Parameters<typeof recoverLiveLogs>[0],
+    checkpoint: LiveLogCheckpoint | null,
+    options: LiveLogRecoveryOptions = {},
+) => recoverLiveLogs(fetchPage, checkpoint, { lateWindowMs: 0, ...options });
+const baseline = () => checkpointFor([row(1)]);
+const emptyBaseline = (): LiveLogCheckpoint => ({ time: '', keys: [] });
+const page = (logs: LiveLogRow[], oldest = ''): LiveLogPage => ({ logs, oldest });
+const scripted = (...pages: LiveLogPage[]) => {
+    let index = 0;
+    return vi.fn(async (_olderThan?: string) => {
+        const next = pages[index];
+        index += 1;
+        if (!next) {
+            throw new Error('Unexpected extra fetch');
+        }
+        return next;
+    });
+};
+const history = (entries: LiveLogRow[]) =>
+    vi.fn(async (olderThan?: string): Promise<LiveLogPage> => {
+        const remaining = olderThan
+            ? entries.filter((entry) => compareTimes(entry.time, olderThan) < 0)
+            : entries;
+        const logs = remaining.slice(0, 100);
+        return page(logs, remaining.length > 100 ? logs[logs.length - 1].time : '');
+    });
+
+describe('recoverLiveLogs baselines and catch-up', () => {
+    it('establishes a baseline once with the entire newest timestamp multiset', async () => {
+        const head = row(3);
+        const other = row(3, { domain: 'other.test' });
+        const fetchPage = scripted(page([row(2), head, head, other], time(2)));
+        const result = await recover(fetchPage, null);
+        expect(fetchPage).toHaveBeenCalledExactlyOnceWith(undefined);
+        expect(result.checkpoint).toEqual(checkpointFor([head, head, other]));
+        expect(result.checkpoint.keys).toHaveLength(3);
+        expect(result.logs.map((entry) => entry.time)).toEqual([
+            time(3),
+            time(3),
+            time(3),
+            time(2),
+        ]);
+        expect(result.gap).toBe(false);
+    });
+
+    it('does not retrospectively drain a full initial page', async () => {
+        const fetchPage = scripted(page(rows(100), time(1)));
+        expect((await recover(fetchPage, null)).gap).toBe(false);
+        expect(fetchPage).toHaveBeenCalledTimes(1);
+    });
+
+    it('records an empty successful initial baseline without draining its scan cursor', async () => {
+        const fetchPage = scripted(page([], time(100)));
+        expect(await recover(fetchPage, null)).toEqual({
+            logs: [],
+            checkpoint: emptyBaseline(),
+            gap: false,
+        });
+        expect(fetchPage).toHaveBeenCalledTimes(1);
+    });
+
+    it.each([0, 20, 99, 100, 250, 500])(
+        'recovers %i new rows before UI truncation',
+        async (count) => {
+            const entries = rows(count + 1);
+            const fetchPage = history(entries);
+            const onCatchUp = vi.fn();
+            const result = await recover(fetchPage, baseline(), { onCatchUp });
+            expect(result.gap).toBe(false);
+            expect(result.logs.map((entry) => entry.time)).toEqual(
+                entries.map((entry) => entry.time),
+            );
+            expect(result.logs).toHaveLength(count + 1);
+            expect(new Set(result.logs.map((entry) => entry.liveKey)).size).toBe(count + 1);
+            expect(fetchPage).toHaveBeenCalledTimes(Math.ceil((count + 1) / 100));
+            expect(onCatchUp).toHaveBeenCalledTimes(count >= 100 ? 1 : 0);
+            expect(result.checkpoint).toEqual(checkpointFor(entries.slice(0, 100)));
+        },
+    );
+
+    it('bounds 2100 new rows at twenty pages and rebases to avoid repeating expensive backfill', async () => {
+        const fetchPage = history(rows(2101));
+        const result = await recover(fetchPage, baseline());
+        expect(result.gap).toBe(true);
+        expect(result.reason).toBe('page-budget');
+        expect(result.logs).toHaveLength(LIVE_LOG_RECOVERY_MAX_ROWS);
+        expect(result.logs[0].time).toBe(time(2101));
+        expect(result.logs[1999].time).toBe(time(102));
+        expect(fetchPage).toHaveBeenCalledTimes(LIVE_LOG_RECOVERY_MAX_PAGES);
+        expect(result.checkpoint).toEqual(checkpointFor(rows(100, 2001)));
+        fetchPage.mockClear();
+        expect((await recover(fetchPage, result.checkpoint)).gap).toBe(false);
+        expect(fetchPage).toHaveBeenCalledTimes(1);
+    });
+
+    it('stops on complete first-page overlap while retaining late completed older rows', async () => {
+        const late = row(3, { elapsedMs: '1200' });
+        const fetchPage = scripted(page([late, row(6), row(5)], time(3)));
+        const onCatchUp = vi.fn();
+        const result = await recover(fetchPage, checkpointFor([row(5)]), { onCatchUp });
+        expect(result.gap).toBe(false);
+        expect(result.logs.map((entry) => entry.time)).toEqual([time(6), time(5), time(3)]);
+        expect(result.logs[2].elapsedMs).toBe('1200');
+        expect(fetchPage).toHaveBeenCalledTimes(1);
+        expect(onCatchUp).not.toHaveBeenCalled();
+    });
+
+    it('preserves full nanoseconds and sorts pages without mutating them', async () => {
+        const input = [row(102), row(104), row(103)];
+        const fetchPage = scripted(page(input, time(102)), page([row(101), row(100)]));
+        const result = await recover(fetchPage, checkpointFor([row(100)]));
+        expect(result.logs.map((entry) => entry.time)).toEqual([104, 103, 102, 101, 100].map(time));
+        expect(input.map((entry) => entry.time)).toEqual([102, 104, 103].map(time));
+        // A short page holds every record down to its cursor, so the next request stays exclusive.
+        expect(fetchPage.mock.calls).toEqual([[undefined], [time(102)]]);
+    });
+});
+
+describe('multiset overlap and ambiguous pagination', () => {
+    it('continues partial overlap until every distinct checkpoint head key is found', async () => {
+        const first = row(5, { domain: 'first.test' });
+        const second = row(5, { domain: 'second.test' });
+        const fetchPage = scripted(page([row(6), first], time(5)), page([second, row(4)]));
+        const result = await recover(fetchPage, checkpointFor([first, second]));
+        expect(result.gap).toBe(false);
+        expect(result.logs).toHaveLength(4);
+        expect(fetchPage).toHaveBeenCalledTimes(2);
+    });
+
+    it('reports partial head loss once the scan passes the checkpoint timestamp', async () => {
+        const first = row(5);
+        const second = row(5, { domain: 'missing.test' });
+        const fetchPage = scripted(page([row(6), first], time(5)), page([row(4)], time(4)));
+        const result = await recover(fetchPage, checkpointFor([first, second]));
+        expect(result.gap).toBe(true);
+        expect(result.reason).toBe('checkpoint-missing');
+        expect(fetchPage).toHaveBeenCalledTimes(2);
+    });
+
+    it('requires missing occurrence keys rather than accepting one indistinguishable duplicate', async () => {
+        const duplicate = row(5);
+        const fetchPage = scripted(page([row(6), duplicate], time(5)), page([row(4)]));
+        const result = await recover(fetchPage, checkpointFor([duplicate, duplicate]));
+        expect(fetchPage.mock.calls).toEqual([[undefined], [time(5)]]);
+        expect(result.gap).toBe(true);
+        expect(result.reason).toBe('checkpoint-missing');
+    });
+
+    it.each([1, 2])(
+        'accepts duplicate frontier identities when %i prior occurrences are all present',
+        async (count) => {
+            const duplicate = row(5);
+            const fetchPage = scripted(page([row(6), duplicate, duplicate], time(5)));
+            const result = await recover(fetchPage, checkpointFor(Array(count).fill(duplicate)));
+            expect(result.logs).toHaveLength(3);
+            expect(result.gap).toBe(false);
+            expect(fetchPage).toHaveBeenCalledTimes(1);
+        },
+    );
+
+    it('merges overlapping pages with maximum per-page multiplicity instead of summing occurrences', async () => {
+        const duplicate = row(5);
+        const renamed = { ...duplicate, client_info: { name: 'Changed' } };
+        const fetchPage = scripted(
+            page([row(6), duplicate, duplicate], time(5)),
+            page([renamed, renamed, renamed, row(4), row(1)]),
+        );
+        const result = await recover(fetchPage, baseline());
+        expect(result.gap).toBe(false);
+        expect(result.logs).toHaveLength(6);
+        expect(result.logs.filter((entry) => entry.time === time(5))).toHaveLength(3);
+        expect(new Set(result.logs.map((entry) => entry.liveKey)).size).toBe(6);
+    });
+
+    it.each([false, true])(
+        'flags a full-page tied cursor boundary with head overlap=%s',
+        async (overlap) => {
+            const first = row(5, { domain: 'first.test' });
+            const second = row(5, { domain: 'second.test' });
+            const full = [...rows(98, 5), first, second];
+            const fetchPage = scripted(page(full, time(5)), page([row(4), row(1)]));
+            const result = await recover(
+                fetchPage,
+                overlap ? checkpointFor([first, second]) : baseline(),
+            );
+            expect(result.gap).toBe(true);
+            expect(result.reason).toBe('ambiguous-page-boundary');
+            expect(fetchPage).toHaveBeenCalledTimes(overlap ? 1 : 2);
+        },
+    );
+
+    it('accepts an explicitly exhausted tied full page with distinct identities', async () => {
+        const first = row(5, { domain: 'first.test' });
+        const second = row(5, { domain: 'second.test' });
+        const fetchPage = scripted(page([...rows(98, 5), first, second]));
+        expect((await recover(fetchPage, checkpointFor([first, second]))).gap).toBe(false);
+    });
+
+    it('accepts timestamp ties away from the cursor boundary', async () => {
+        const entries = [...rows(97, 5), row(5), row(5, { type: 'AAAA' }), row(1)];
+        expect((await recover(scripted(page(entries, time(1))), baseline())).gap).toBe(false);
+    });
+});
+
+describe('filtered scans, cursor safety, and checkpoint expiry', () => {
+    it('drains a formerly empty baseline through full and short pages to explicit exhaustion', async () => {
+        const fetchPage = scripted(
+            page(rows(100, 200), time(201)),
+            page(rows(2, 100), time(100)),
+            page([row(50)]),
+        );
+        const result = await recover(fetchPage, emptyBaseline());
+        expect(result.gap).toBe(false);
+        expect(result.logs).toHaveLength(103);
+        expect(fetchPage).toHaveBeenCalledTimes(3);
+    });
+
+    it('does not assume a short newest page is exhausted for a previously empty baseline', async () => {
+        const fetchPage = scripted(page([row(5)], time(4)), page([row(3)]));
+        const result = await recover(fetchPage, emptyBaseline());
+        expect(result.logs).toHaveLength(2);
+        expect(result.gap).toBe(false);
+        expect(fetchPage).toHaveBeenCalledTimes(2);
+    });
+
+    it('continues through empty scans and checkpoints the newest recovered group', async () => {
+        const fetchPage = scripted(
+            page([], time(10)),
+            page([], time(8)),
+            page([row(7)], time(5)),
+            page([row(1)]),
+        );
+        const result = await recover(fetchPage, baseline());
+        expect(result.gap).toBe(false);
+        expect(result.logs.map((entry) => entry.time)).toEqual([time(7), time(1)]);
+        expect(result.checkpoint).toEqual(checkpointFor([row(7)]));
+        expect(fetchPage.mock.calls).toEqual([[undefined], [time(10)], [time(8)], [time(5)]]);
+    });
+
+    it('drains empty progressing scans from an empty baseline', async () => {
+        const fetchPage = scripted(page([], time(10)), page([], time(5)), page([]));
+        expect(await recover(fetchPage, emptyBaseline())).toEqual({
+            logs: [],
+            checkpoint: emptyBaseline(),
+            gap: false,
+        });
+        expect(fetchPage).toHaveBeenCalledTimes(3);
+    });
+
+    it('detects an empty scan passing the frontier without another request', async () => {
+        const fetchPage = scripted(page([], time(4)));
+        expect((await recover(fetchPage, checkpointFor([row(5)]))).reason).toBe(
+            'checkpoint-missing',
+        );
+        expect(fetchPage).toHaveBeenCalledTimes(1);
+    });
+
+    it.each([false, true])('reports expired checkpoints with older rows=%s', async (older) => {
+        const fetchPage = scripted(older ? page([row(3)], time(3)) : page([]));
+        const result = await recover(fetchPage, checkpointFor([row(5)]));
+        expect(result.gap).toBe(true);
+        expect(result.reason).toBe('checkpoint-missing');
+        expect(result.checkpoint).toEqual(
+            older ? checkpointFor([row(3)]) : { ...checkpointFor([row(5)]), limited: true },
+        );
+    });
+
+    it.each([undefined, null, 12, 'garbage', '0', '2026-10-01', '2026-10-01T25:00:00Z'])(
+        'guards missing or malformed cursor %s',
+        async (oldest) => {
+            const fetchPage = scripted({ logs: [row(5)], oldest } as LiveLogPage);
+            const result = await recover(fetchPage, baseline());
+            expect(result.reason).toBe('invalid-cursor');
+            expect(result.gap).toBe(true);
+            expect(fetchPage).toHaveBeenCalledTimes(1);
+        },
+    );
+
+    it('validates initial baseline cursors', async () => {
+        const result = await recover(scripted(page([row(5)], 'bad')), null);
+        expect(result.reason).toBe('invalid-cursor');
+        expect(result.checkpoint).toEqual(checkpointFor([row(5)]));
+    });
+
+    it.each([time(5), time(6), '2026-10-01T12:00:00.000000005+00:00'])(
+        'guards repeated or increasing cursor %s',
+        async (oldest) => {
+            const fetchPage = scripted(page([row(10)], time(5)), page([], oldest));
+            const result = await recover(fetchPage, baseline());
+            expect(result.reason).toBe('nonprogressing-cursor');
+            expect(fetchPage).toHaveBeenCalledTimes(2);
+            expect(result.checkpoint).toEqual(checkpointFor([row(10)]));
+        },
+    );
+});
+
+describe('budgets, partial API failures, and cancellation', () => {
+    it('uses the default monotonic 5000ms budget before another request', async () => {
+        const now = vi.spyOn(performance, 'now').mockReturnValueOnce(0).mockReturnValue(5000);
+        try {
+            const fetchPage = scripted(page(rows(100, 100), time(101)));
+            const result = await recover(fetchPage, baseline());
+            expect(result.reason).toBe('time-budget');
+            expect(result.checkpoint).toEqual(checkpointFor(rows(100, 100)));
+            expect(fetchPage).toHaveBeenCalledTimes(1);
+        } finally {
+            now.mockRestore();
+        }
+        expect(LIVE_LOG_RECOVERY_MAX_DURATION_MS).toBe(5000);
+    });
+
+    it('enforces elapsed duration cumulatively across short pages', async () => {
+        let elapsed = 0;
+        const fetchPage = vi.fn(async () => {
+            elapsed += 2000;
+            return page([row(100 - elapsed / 1000)], time(99 - elapsed / 1000));
+        });
+        const result = await recover(fetchPage, baseline(), { now: () => elapsed });
+        expect(result.reason).toBe('time-budget');
+        expect(fetchPage).toHaveBeenCalledTimes(3);
+        expect(result.logs).toHaveLength(3);
+    });
+
+    it('supports reduced budgets while capping increased options at hard limits', async () => {
+        const limited = history(rows(1000));
+        expect((await recover(limited, baseline(), { maxPages: 2 })).reason).toBe('page-budget');
+        expect(limited).toHaveBeenCalledTimes(2);
+        const capped = history(rows(3000));
+        await recover(capped, baseline(), { maxPages: 100 });
+        expect(capped).toHaveBeenCalledTimes(LIVE_LOG_RECOVERY_MAX_PAGES);
+        let elapsed = 0;
+        const timed = vi.fn(async () => {
+            elapsed += 5000;
+            return page([row(10)], time(10));
+        });
+        const result = await recover(timed, baseline(), {
+            now: () => elapsed,
+            maxDurationMs: 100000,
+        });
+        expect(result.reason).toBe('time-budget');
+        expect(timed).toHaveBeenCalledTimes(1);
+    });
+
+    it('returns partial rows and preserves the original checkpoint for retry after API failure', async () => {
+        const original = baseline();
+        const snapshot = JSON.stringify(original);
+        const error = new Error('disconnected');
+        const fetchPage = vi
+            .fn()
+            .mockResolvedValueOnce(page([row(3)], time(3)))
+            .mockRejectedValueOnce(error);
+        const result = await recover(fetchPage, original);
+        expect(result.error).toBe(error);
+        expect(result.checkpoint).toBe(original);
+        expect(result.gap).toBe(false);
+        expect(result.reason).toBeUndefined();
+        expect(result.logs).toEqual(identifyLiveLogs([row(3)]));
+        expect(JSON.stringify(original)).toBe(snapshot);
+        const retry = await recover(history(rows(3)), result.checkpoint);
+        expect(retry.gap).toBe(false);
+        expect(retry.logs).toHaveLength(3);
+    });
+
+    it.each([null, baseline()])(
+        'preserves the input checkpoint on initial fetch failure (%s)',
+        async (original) => {
+            const error = new Error('offline');
+            const result = await recover(vi.fn().mockRejectedValue(error), original);
+            expect(result).toEqual({ logs: [], checkpoint: original, gap: false, error });
+        },
+    );
+
+    it('does not mutate frozen checkpoint keys or page rows', async () => {
+        const original = baseline();
+        Object.freeze(original.keys);
+        Object.freeze(original);
+        const entries = [Object.freeze(row(3)), Object.freeze(row(1))];
+        Object.freeze(entries);
+        expect((await recover(scripted(page(entries)), original)).gap).toBe(false);
+        expect(original).toEqual(baseline());
+    });
+
+    it('requests pages sequentially and invokes the catch-up callback only once', async () => {
+        let active = 0;
+        const fetchPage = vi.fn(async (olderThan?: string) => {
+            active += 1;
+            expect(active).toBe(1);
+            await Promise.resolve();
+            active -= 1;
+            return olderThan ? page([row(1)]) : page([row(3)], time(3));
+        });
+        const onCatchUp = vi.fn();
+        expect((await recover(fetchPage, baseline(), { onCatchUp })).gap).toBe(false);
+        expect(onCatchUp).toHaveBeenCalledTimes(1);
+    });
+
+    it.each(['signal', 'stale'])('rejects before fetching when cancelled via %s', async (kind) => {
+        const controller = new AbortController();
+        if (kind === 'signal') {
+            controller.abort();
+        }
+        const fetchPage = scripted(page([row(2)]));
+        await expect(
+            recover(fetchPage, baseline(), {
+                signal: controller.signal,
+                isCurrent: () => kind !== 'stale',
+            }),
+        ).rejects.toMatchObject({ name: 'AbortError' });
+        expect(fetchPage).not.toHaveBeenCalled();
+    });
+
+    it.each(['signal', 'stale'])(
+        'rejects after an in-flight fetch is cancelled via %s',
+        async (kind) => {
+            const controller = new AbortController();
+            let current = true;
+            const original = baseline();
+            const fetchPage = vi.fn(async () => {
+                if (kind === 'signal') {
+                    controller.abort();
+                } else {
+                    current = false;
+                }
+                return page([row(3), row(1)]);
+            });
+            await expect(
+                recover(fetchPage, original, {
+                    signal: controller.signal,
+                    isCurrent: () => current,
+                }),
+            ).rejects.toMatchObject({ name: 'AbortError' });
+            expect(original).toEqual(baseline());
+            expect(fetchPage).toHaveBeenCalledTimes(1);
+        },
+    );
+
+    it('checks cancellation after onCatchUp before the next request', async () => {
+        const controller = new AbortController();
+        const fetchPage = scripted(page([row(3)], time(3)));
+        await expect(
+            recover(fetchPage, baseline(), {
+                signal: controller.signal,
+                onCatchUp: () => controller.abort(),
+            }),
+        ).rejects.toMatchObject({ name: 'AbortError' });
+        expect(fetchPage).toHaveBeenCalledTimes(1);
+    });
+
+    it('rejects independently aborted fetches', async () => {
+        const error = new DOMException('Request deadline', 'AbortError');
+        await expect(recover(vi.fn().mockRejectedValue(error), baseline())).rejects.toMatchObject({
+            name: 'AbortError',
+        });
+    });
+    it('rebases an empty first page onto recovered rows and avoids repeating the page budget', async () => {
+        const initial = scripted(page([], time(50)), page([row(40)], time(40)));
+        const result = await recover(initial, baseline(), { maxPages: 2 });
+        expect(result.reason).toBe('page-budget');
+        expect(result.checkpoint).toEqual(checkpointFor([row(40)]));
+        const again = scripted(page([], time(50)), page([row(40)], time(40)));
+        const next = await recover(again, result.checkpoint);
+        expect(next.gap).toBe(false);
+        expect(again).toHaveBeenCalledTimes(2);
+    });
+
+    it('probes only the head after an all-empty scan exhausts its budget', async () => {
+        const initial = scripted(page([], time(50)), page([], time(40)));
+        const result = await recover(initial, baseline(), { maxPages: 2 });
+        expect(result.checkpoint).toEqual({ ...baseline(), limited: true });
+        const again = scripted(page([], time(50)));
+        const next = await recover(again, result.checkpoint);
+        expect(again).toHaveBeenCalledTimes(1);
+        expect(next.gap).toBe(true);
+        expect(next.checkpoint).toEqual(result.checkpoint);
+        const fresh = await recover(scripted(page([row(60)], time(50))), next.checkpoint);
+        expect(fresh.checkpoint).toEqual(checkpointFor([row(60)]));
+        expect(fresh.gap).toBe(true);
+    });
+});
+
+describe('late-arrival window', () => {
+    const base = '2026-10-01T12:00:00.000000000Z';
+    const at = (ms: number, extra = {}): LiveLogRow => ({
+        time: shiftLiveLogTime(base, ms),
+        domain: `t${ms}.test`,
+        client: '192.0.2.1',
+        type: 'A',
+        ...extra,
+    });
+
+    it('shifts timestamps by milliseconds, keeping sub-millisecond digits and normalising to UTC', () => {
+        expect(shiftLiveLogTime('2026-10-01T12:00:00.000123456Z', -3000)).toBe(
+            '2026-10-01T11:59:57.000123456Z',
+        );
+        expect(shiftLiveLogTime('2026-10-01T14:00:00.5+02:00', -3000)).toBe(
+            '2026-10-01T11:59:57.500000000Z',
+        );
+        expect(shiftLiveLogTime('2026-10-01T12:00:00Z', 1)).toBe('2026-10-01T12:00:00.001000000Z');
+    });
+
+    it('only requests cursors that the server returned', async () => {
+        const head = at(10000);
+        const entries = [
+            ...Array.from({ length: 250 }, (_, index) => at(10999 - index)),
+            head,
+            ...Array.from({ length: 300 }, (_, index) => at(9999 - index * 10)),
+        ];
+        const fetchPage = history(entries);
+        const returned = new Set<string | undefined>([undefined]);
+        const wrapped = vi.fn(async (olderThan?: string) => {
+            expect(returned.has(olderThan)).toBe(true);
+            const result = await fetchPage(olderThan);
+            returned.add(result.oldest);
+            return result;
+        });
+        expect((await recoverLiveLogs(wrapped, checkpointFor([head]))).gap).toBe(false);
+        expect(wrapped.mock.calls.length).toBeGreaterThan(3);
+    });
+
+    it('computes the window start from the checkpoint', () => {
+        expect(liveLogWindowStart(null)).toBeUndefined();
+        expect(liveLogWindowStart({ time: '', keys: [] })).toBe('');
+        expect(liveLogWindowStart(checkpointFor([at(10000)]))).toBe(
+            at(10000 - LIVE_LOG_LATE_WINDOW_MS).time,
+        );
+        expect(liveLogWindowStart(checkpointFor([at(10000)]), 0)).toBe(at(10000).time);
+    });
+
+    it('recovers a record that became visible behind the checkpoint', async () => {
+        const head = at(10000);
+        const late = at(9500);
+        const fetchPage = history([at(11000), head, late, at(1000)]);
+        const result = await recoverLiveLogs(fetchPage, checkpointFor([head]));
+        expect(result.gap).toBe(false);
+        expect(result.logs.map((entry) => entry.time)).toContain(late.time);
+        expect(fetchPage).toHaveBeenCalledTimes(1);
+    });
+
+    it('reads past the checkpoint page to cover the window without signalling catch-up', async () => {
+        const head = at(10000);
+        const late = at(8000);
+        const fresh = Array.from({ length: 99 }, (_, index) => at(10100 + index));
+        const entries = [...fresh.reverse(), head, late, at(1000)];
+        const fetchPage = history(entries);
+        const onCatchUp = vi.fn();
+        const result = await recoverLiveLogs(fetchPage, checkpointFor([head]), { onCatchUp });
+        expect(fetchPage.mock.calls).toEqual([[undefined], [head.time]]);
+        expect(result.gap).toBe(false);
+        expect(result.logs).toHaveLength(entries.length);
+        expect(onCatchUp).not.toHaveBeenCalled();
+        expect(result.checkpoint).toEqual(checkpointFor([entries[0]]));
+    });
+
+    it('stops as soon as a page reaches rows older than the window', async () => {
+        const head = at(10000);
+        const fetchPage = scripted(page([at(10500), head, at(6000)], at(6000).time));
+        const result = await recoverLiveLogs(fetchPage, checkpointFor([head]));
+        expect(result.gap).toBe(false);
+        expect(fetchPage).toHaveBeenCalledTimes(1);
+    });
+
+    it('stops re-reading after the row bound behind the checkpoint', async () => {
+        const head = at(10000);
+        // 600 rows within one second behind the checkpoint: the row bound ends the re-read first.
+        const behind = Array.from({ length: 600 }, (_, index) => at(9999 - index));
+        const fetchPage = history([head, ...behind, at(1000)]);
+        const result = await recoverLiveLogs(fetchPage, checkpointFor([head]));
+        expect(result.gap).toBe(false);
+        // Pages: 1 head + 99 behind, then 100 more per page until at least 500 are behind.
+        expect(fetchPage).toHaveBeenCalledTimes(6);
+        expect(LIVE_LOG_LATE_WINDOW_ROWS).toBe(500);
+    });
+
+    it('retries a briefly hidden checkpoint once before reporting it missing', async () => {
+        const head = at(10000);
+        const fresh = at(10500);
+        const hidden = await recoverLiveLogs(history([fresh, at(1000)]), checkpointFor([head]));
+        expect(hidden.gap).toBe(false);
+        expect(hidden.checkpoint).toEqual({ ...checkpointFor([head]), retry: true });
+        expect(hidden.logs.map((entry) => entry.time)).toContain(fresh.time);
+        const visible = await recoverLiveLogs(history([fresh, head, at(1000)]), hidden.checkpoint);
+        expect(visible.gap).toBe(false);
+        expect(visible.checkpoint).toEqual(checkpointFor([fresh]));
+        const gone = await recoverLiveLogs(history([fresh, at(1000)]), hidden.checkpoint);
+        expect(gone.gap).toBe(true);
+        expect(gone.reason).toBe('checkpoint-missing');
+        expect(gone.checkpoint).toEqual(checkpointFor([fresh]));
+    });
+
+    it('reports a gap when the page budget ends before the window is covered', async () => {
+        const head = at(10000);
+        const fetchPage = scripted(
+            page([at(10500), head], head.time),
+            page([at(9000)], at(9000).time),
+        );
+        const result = await recoverLiveLogs(fetchPage, checkpointFor([head]), { maxPages: 2 });
+        expect(result.gap).toBe(true);
+        expect(result.reason).toBe('page-budget');
+    });
+});
