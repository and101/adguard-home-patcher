+        expect(single.queries).toEqual([47, 47]);
+        expect(single.blocked).toEqual([4, 4]);
+        expect(single.labels[0]).toBe(single.labels[1]);
+        expect(padHistory([], [], 'hours').queries).toEqual([0, 0]);
+    });
+});
