+// Extra dashboard time ranges.  A range is an ordinary stats period (a whole
+// number of hours in milliseconds, sent as the "recent" parameter of
+// GET /control/stats), so the selection stays in the browser and neither the
+// configuration file nor the statistics database change.
+
+import { DAY, HOUR, STATS_INTERVALS_DAYS } from 'panel/helpers/constants';
+import { LocalStorageHelper } from 'panel/helpers/localStorageHelper';
+
+export const STATS_TODAY_STORAGE_KEY = 'stats_period_today';
+
+/** Select values that are not periods. */
+export const STATS_PERIOD_TODAY = -1;
+export const STATS_PERIOD_CUSTOM = -2;
+
+/** Presets offered in addition to the stock 6 hours … 90 days. */
+export const EXTRA_STATS_PERIODS = [HOUR, 12 * HOUR];
+
+export const STATS_PERIOD_PRESETS = [...EXTRA_STATS_PERIODS, ...STATS_INTERVALS_DAYS].sort(
+    (a, b) => a - b,
+);
+
+export const CUSTOM_PERIOD_UNITS = { hours: HOUR, days: DAY } as const;
+export type CustomPeriodUnit = keyof typeof CUSTOM_PERIOD_UNITS;
+
+export const loadTodaySelected = () => LocalStorageHelper.getItem(STATS_TODAY_STORAGE_KEY) === true;
+export const saveTodaySelected = (today: boolean) =>
+    LocalStorageHelper.setItem(STATS_TODAY_STORAGE_KEY, today);
+
+/**
+ * The period covering today.  Statistics are stored per clock hour and the
+ * current hour is always included, so this is the number of hours elapsed
+ * since local midnight plus the current one.
+ */
+export const getTodayPeriod = (now: Date = new Date()): number => {
+    const midnight = new Date(now);
+    midnight.setHours(0, 0, 0, 0);
+
+    return (Math.floor((now.getTime() - midnight.getTime()) / HOUR) + 1) * HOUR;
+};
+
+/**
+ * Validates a custom range.  Returns the period, or an error message when the
+ * value is not a positive whole number or exceeds the retention period.
+ */
+export const parseCustomPeriod = (
+    value: string,
+    unit: CustomPeriodUnit,
+    maxInterval: number,
+): { period: number } | { error: string } => {
+    const count = Number(value.trim());
+    if (!/^\d+$/.test(value.trim()) || !Number.isSafeInteger(count) || count < 1) {
+        return { error: STATS_RANGE_TEXT.invalid };
+    }
+    const period = count * CUSTOM_PERIOD_UNITS[unit];
+    if (period > maxInterval) {
+        return { error: STATS_RANGE_TEXT.too_long };
+    }
+
+    return { period };
+};
+
+/** The custom editor starts in days for whole days and in hours otherwise. */
+export const splitCustomPeriod = (period: number): { value: string; unit: CustomPeriodUnit } =>
+    period >= DAY && period % DAY === 0
+        ? { value: String(period / DAY), unit: 'days' }
+        : { value: String(Math.max(1, Math.round(period / HOUR))), unit: 'hours' };
+
+// The strings are kept here instead of in the locale files so that the patch
+// does not touch files that change in every release.  They are English only;
+// period labels such as "Last 12 hours" use the translated stock strings.
+export const STATS_RANGE_TEXT = {
+    today: 'Today',
+    custom: 'Custom…',
+    custom_title: 'Custom time range',
+    custom_last: 'Last',
+    hours: 'hours',
+    days: 'days',
+    apply: 'Apply',
+    cancel: 'Cancel',
+    invalid: 'Enter a whole number greater than zero',
+    too_long: 'Longer than the statistics retention period',
+};
