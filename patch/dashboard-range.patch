+import { createSignal, untrack } from 'solid-js';
+
+import { Input } from 'panel/common/controls/Input';
+import { Select } from 'panel/common/controls/Select';
+import { Button } from 'panel/common/ui/Button';
+import { IOption } from 'panel/lib/helpers/utils';
+import {
+    parseCustomPeriod,
+    splitCustomPeriod,
+    STATS_RANGE_TEXT,
+    type CustomPeriodUnit,
+} from 'panel/helpers/statsRange';
+
+import s from './CustomPeriod.module.pcss';
+
+type Props = {
+    period: number;
+    maxInterval: number;
+    onApply: (period: number) => void;
+    onCancel: () => void;
+};
+
+const UNIT_OPTIONS: IOption<CustomPeriodUnit>[] = [
+    { value: 'hours', label: STATS_RANGE_TEXT.hours },
+    { value: 'days', label: STATS_RANGE_TEXT.days },
+];
+
+/** Inline editor for a custom dashboard range of whole hours or days. */
+export const CustomPeriod = (props: Props) => {
+    const initial = splitCustomPeriod(untrack(() => props.period));
+    const [value, setValue] = createSignal(initial.value);
+    const [unit, setUnit] = createSignal<CustomPeriodUnit>(initial.unit);
+    const [error, setError] = createSignal('');
+
+    const handleSubmit = (event: Event) => {
+        event.preventDefault();
+        const result = parseCustomPeriod(value(), unit(), props.maxInterval);
+        if ('error' in result) {
+            setError(result.error);
+            return;
+        }
+        props.onApply(result.period);
+    };
+
+    return (
+        <form
+            class={s.form}
+            data-testid="stats-custom-period"
+            aria-label={STATS_RANGE_TEXT.custom_title}
+            onSubmit={handleSubmit}
+        >
+            <span class={s.label}>{STATS_RANGE_TEXT.custom_last}</span>
+            <Input
+                data-testid="stats-custom-period-value"
+                class={s.value}
+                type="number"
+                inputMode="numeric"
+                min={1}
+                step={1}
+                size="small"
+                aria-label={STATS_RANGE_TEXT.custom_title}
+                value={value()}
+                invalid={!!error()}
+                onInput={(event) => {
+                    setValue(event.currentTarget.value);
+                    setError('');
+                }}
+            />
+            <div class={s.unit} data-testid="stats-custom-period-unit">
