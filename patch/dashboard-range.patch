+import { Show } from 'solid-js';
+import cn from 'clsx';
+
+import { Button } from 'panel/common/ui/Button';
+import { FaqTooltip } from 'panel/common/ui/FaqTooltip';
+import { LIVE_LOG_TEXT, liveLogNewText } from 'panel/helpers/liveQueryLog';
+
+import type { LiveLogStatus } from '../../useLiveQueryLog';
+
+import s from './LiveBar.module.pcss';
+
+type Props = {
+    ref?: (element: HTMLDivElement) => void;
+    live: boolean;
+    status: LiveLogStatus;
+    hasGap: boolean;
+    disabled: boolean;
+    onToggle: () => void;
+    onClear: () => void;
+};
+
+const STATUS_LABEL: Record<LiveLogStatus, string> = {
+    synced: LIVE_LOG_TEXT.synced,
+    gap: LIVE_LOG_TEXT.synced,
+    catching_up: LIVE_LOG_TEXT.catching_up,
+    reconnecting: LIVE_LOG_TEXT.reconnecting,
+    suspended: LIVE_LOG_TEXT.suspended,
+    paused: LIVE_LOG_TEXT.paused,
+};
+
+export const LiveBar = (props: Props) => (
+    <div ref={props.ref} class={s.bar} data-testid="query-log-live-bar">
+        <Button
+            data-testid="query-log-live-toggle"
+            class={s.toggle}
+            variant={props.live ? 'secondary' : 'primary'}
+            size="small"
+            aria-pressed={props.live}
+            disabled={props.disabled}
+            onClick={props.onToggle}
+        >
+            {props.live ? LIVE_LOG_TEXT.pause : LIVE_LOG_TEXT.start}
+        </Button>
+
+        <div class={cn(s.status, s[props.status])}>
+            <span class={s.dot} aria-hidden="true" />
+            <span
+                data-testid="query-log-live-status"
+                data-status={props.status}
+                role="status"
+                aria-live="polite"
+            >
+                {STATUS_LABEL[props.status]}
+            </span>
+            <Show when={props.live}>
+                <FaqTooltip text={LIVE_LOG_TEXT.status_hint} />
+            </Show>
+        </div>
+
+        <Show when={props.live}>
+            <Button
+                data-testid="query-log-live-clear"
+                compact
+                class={s.clear}
+                variant="ghost"
+                size="small"
+                title={LIVE_LOG_TEXT.clear_hint}
+                aria-describedby="query-log-live-clear-hint"
+                onClick={props.onClear}
+            >
+                {LIVE_LOG_TEXT.clear}
+            </Button>
+            <span id="query-log-live-clear-hint" class={s.srOnly}>
+                {LIVE_LOG_TEXT.clear_hint}
+            </span>
+        </Show>
+
+        <Show when={props.live && props.hasGap}>
+            <p class={s.gapNotice} data-testid="query-log-live-gap" role="alert">
+                {LIVE_LOG_TEXT.gap}
+            </p>
+        </Show>
+    </div>
+);
+
+type NewQueriesProps = {
+    count: number;
+    onShow: () => void;
+};
+
+/** Shown above the list while new rows wait because the user is reading older rows. */
+export const NewQueriesButton = (props: NewQueriesProps) => (
+    <Show when={props.count > 0}>
+        <div class={s.pending}>
+            <Button
+                data-testid="query-log-live-pending"
+                compact
+                class={s.pendingButton}
+                variant="primary"
+                size="small"
+                title={LIVE_LOG_TEXT.new_hint}
+                onClick={props.onShow}
+            >
+                {liveLogNewText(props.count)}
+            </Button>
+        </div>
+    </Show>
+);
