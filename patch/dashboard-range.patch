@@ -0,0 +1,195 @@
+import { createMemo, onCleanup, onMount, untrack } from 'solid-js';
+import cn from 'clsx';
+import {
+    CategoryScale,
+    Chart,
+    Filler,
+    LinearScale,
+    LineController,
+    LineElement,
+    PointElement,
+    Tooltip,
+    type ScriptableContext,
+} from 'chart.js';
+
+import intl from 'panel/common/intl';
+import theme from 'panel/lib/theme';
+import { formatNumber } from 'panel/helpers/helpers';
+import { formatHistoryLabel } from 'panel/helpers/lineUtils';
+import {
+    createCursorLinePlugin,
+    createExternalTooltipHandler,
+    useChart,
+} from 'panel/helpers/useChart';
+import { CARDS_COLORS } from '../StatCard/StatCard';
+
+import s from './QueriesChart.module.pcss';
+
+Chart.register(
+    LineController,
+    LineElement,
+    PointElement,
+    LinearScale,
+    CategoryScale,
+    Tooltip,
+    Filler,
+);
+
+const QUERIES_COLOR = '#4B8FD9';
+const BLOCKED_COLOR = CARDS_COLORS.ADS;
+
+type Props = {
+    dnsQueries: number[];
+    blockedFiltering: number[];
+    replacedSafebrowsing: number[];
+    replacedParental: number[];
+    timeUnits: string;
+};
+
+/** Everything the dashboard counts as blocked, per bucket. */
+export const sumBlocked = (...series: number[][]): number[] => {
+    const length = Math.max(0, ...series.map((values) => values.length));
+    return Array.from({ length }, (_, index) =>
+        series.reduce((total, values) => total + (values[index] || 0), 0),
+    );
+};
+
+/**
+ * Chart.js needs two points for a line.  A single bucket (e.g. the last hour)
+ * is drawn flat with the same label at both ends; no data becomes zero.
+ */
+export const padHistory = (queries: number[], blocked: number[], timeUnits: string) => {
+    const count = queries.length;
+    if (count >= 2) {
+        return {
+            queries,
+            blocked,
+            labels: queries.map((_, index) => formatHistoryLabel(index, count, timeUnits)),
+        };
+    }
+    const label = formatHistoryLabel(0, 1, timeUnits);
+    return {
+        queries: [queries[0] || 0, queries[0] || 0],
+        blocked: [blocked[0] || 0, blocked[0] || 0],
+        labels: [label, label],
+    };
+};
+
+const gradient = (color: string) => (context: ScriptableContext<'line'>) => {
+    const { ctx, height } = context.chart;
+    const fill = ctx.createLinearGradient(0, 0, 0, height || 200);
+    fill.addColorStop(0, `${color}66`);
+    fill.addColorStop(1, `${color}0D`);
+    return fill;
+};
+
+const dataset = (data: number[], color: string, label: string, order: number) => ({
+    label,
+    data,
+    order,
+    borderColor: color,
+    borderWidth: 1.5,
+    backgroundColor: gradient(color),
+    fill: 'origin' as const,
+    clip: false as const,
+    pointRadius: 0,
+    pointHoverRadius: 4,
+    pointHoverBackgroundColor: color,
+    tension: 0.4,
+});
+
+/** Queries and blocked queries overlaid on one time axis. */
+export const QueriesChart = (props: Props) => {
+    const series = createMemo(() =>
+        padHistory(
+            props.dnsQueries,
+            sumBlocked(props.blockedFiltering, props.replacedSafebrowsing, props.replacedParental),
+            props.timeUnits,
+        ),
+    );
+
+    const chartData = createMemo(() => {
+        const { queries, blocked, labels } = series();
+        // Blocked is drawn last so it stays visible in front of the queries area.
+        return {
+            labels,
+            datasets: [
+                dataset(blocked, BLOCKED_COLOR, intl.getMessage('blocked'), 0),
+                dataset(queries, QUERIES_COLOR, intl.getMessage('dns_queries'), 1),
+            ],
+        };
+    });
+
+    let tooltipEl!: HTMLDivElement;
+    const externalTooltipHandler = createExternalTooltipHandler(
+        () => tooltipEl,
+        (dataPoint) => {
+            const { queries, blocked, labels } = series();
+            const index = dataPoint.dataIndex;
+            const row = (color: string, label: string, value: number) =>
+                `<div class="${s.tooltipRow}"><span class="${s.dot}" style="background:${color}"></span>` +
+                `<span>${label}</span><span class="${s.tooltipValue}">${formatNumber(value)}</span></div>`;
+            return (
+                row(QUERIES_COLOR, intl.getMessage('dns_queries'), queries[index]) +
+                row(BLOCKED_COLOR, intl.getMessage('blocked'), blocked[index]) +
+                `<div class="${s.tooltipDate}">${labels[index]}</div>`
+            );
+        },
+    );
+
+    const chartOptions = createMemo(() => ({
+        responsive: true,
+        maintainAspectRatio: false,
+        animation: false as const,
+        layout: { padding: { top: 8, bottom: 4, left: 4, right: 4 } },
+        plugins: {
+            tooltip: { enabled: false, external: externalTooltipHandler },
+            legend: { display: false },
+        },
+        scales: {
+            x: { display: false },
+            y: { display: false, min: 0 },
+        },
+        interaction: { intersect: false, mode: 'index' as const },
+    }));
+
+    const { setCanvasRef, hideTooltip } = untrack(() =>
+        useChart(chartData, chartOptions, [createCursorLinePlugin(QUERIES_COLOR)]),
+    );
+
+    // Chart.js keeps tooltips open after a tap; close them on taps elsewhere.
+    onMount(() => {
+        const onPointerDown = (event: PointerEvent) => {
+            if (
+                tooltipEl?.style.opacity === '1' &&
+                !tooltipEl.parentElement?.contains(event.target as Node)
+            ) {
+                hideTooltip();
+            }
+        };
+        document.addEventListener('pointerdown', onPointerDown, true);
+        onCleanup(() => document.removeEventListener('pointerdown', onPointerDown, true));
+    });
+
+    return (
+        <section class={s.card} data-testid="dashboard-queries-chart">
+            <div class={s.header}>
+                <h2 class={cn(theme.title.h5, s.title)}>{intl.getMessage('queries')}</h2>
+                <div class={cn(theme.text.t3, s.legend)}>
+                    <span class={s.legendItem}>
+                        <span class={s.dot} style={{ background: QUERIES_COLOR }} />
+                        {intl.getMessage('dns_queries')}
+                    </span>
+                    <span class={s.legendItem}>
+                        <span class={s.dot} style={{ background: BLOCKED_COLOR }} />
+                        {intl.getMessage('blocked')}
+                    </span>
+                </div>
+            </div>
+            <div class={s.chart}>
+                <canvas ref={setCanvasRef} role="img" aria-label={intl.getMessage('queries')} />
+                <div ref={(element) => (tooltipEl = element)} class={s.tooltip} />
+            </div>
+        </section>
+    );
+};
