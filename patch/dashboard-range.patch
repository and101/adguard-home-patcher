+import { describe, expect, it } from 'vitest';
+
+import { DAY, HOUR } from 'panel/helpers/constants';
+import {
+    getTodayPeriod,
+    parseCustomPeriod,
+    splitCustomPeriod,
+    STATS_PERIOD_PRESETS,
+    STATS_RANGE_TEXT,
+} from 'panel/helpers/statsRange';
+
+describe('dashboard stats ranges', () => {
+    it('adds 1 and 12 hours to the stock presets in ascending order', () => {
+        expect(STATS_PERIOD_PRESETS).toEqual([
+            HOUR,
+            6 * HOUR,
+            12 * HOUR,
+            DAY,
+            7 * DAY,
+            30 * DAY,
+            90 * DAY,
+        ]);
+    });
+
+    it('counts today from local midnight including the current hour', () => {
+        expect(getTodayPeriod(new Date(2026, 10, 19, 0, 5))).toBe(HOUR);
+        expect(getTodayPeriod(new Date(2026, 10, 19, 13, 59))).toBe(14 * HOUR);
+        expect(getTodayPeriod(new Date(2026, 10, 19, 23, 0))).toBe(24 * HOUR);
+    });
+
+    it('accepts whole hours and days within the retention period', () => {
+        expect(parseCustomPeriod('13', 'hours', DAY)).toEqual({ period: 13 * HOUR });
+        expect(parseCustomPeriod(' 3 ', 'days', 7 * DAY)).toEqual({ period: 3 * DAY });
+        expect(parseCustomPeriod('24', 'hours', DAY)).toEqual({ period: DAY });
+    });
+
+    it('rejects invalid values and ranges longer than the retention period', () => {
+        ['', '0', '-1', '1.5', 'abc', '1e3'].forEach((value) => {
+            expect(parseCustomPeriod(value, 'hours', DAY)).toEqual({
+                error: STATS_RANGE_TEXT.invalid,
+            });
+        });
+        expect(parseCustomPeriod('25', 'hours', DAY)).toEqual({ error: STATS_RANGE_TEXT.too_long });
+        expect(parseCustomPeriod('8', 'days', 7 * DAY)).toEqual({
+            error: STATS_RANGE_TEXT.too_long,
+        });
+    });
+
+    it('opens the editor in days only for whole days', () => {
+        expect(splitCustomPeriod(13 * HOUR)).toEqual({ value: '13', unit: 'hours' });
+        expect(splitCustomPeriod(3 * DAY)).toEqual({ value: '3', unit: 'days' });
+        expect(splitCustomPeriod(36 * HOUR)).toEqual({ value: '36', unit: 'hours' });
+    });
+});
